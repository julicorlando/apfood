// =============================================================================
// ApFood — Esquema do banco de dados (PostgreSQL)
// =============================================================================
// Convenções:
//   • IDs são UUID gerados no CLIENTE quando possível (desktop offline), o que
//     torna a sincronização idempotente: reenviar o mesmo registro = upsert.
//   • Valores monetários em CENTAVOS (Int). Nunca usar float para dinheiro.
//   • Quantidades de estoque em Decimal(12,3) (suporta kg, g, L, ml, un).
//   • Tabelas sincronizáveis possuem updatedAt (indexado) + deletedAt (soft
//     delete), usados como cursor de "pull" pelo app desktop.
//   • Nomes de tabelas/colunas no banco em snake_case via @@map / @map.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum PapelUsuario {
  ADMIN
  GERENTE
  OPERADOR
}

enum CanalVenda {
  ONLINE // cardápio digital
  BALCAO // consumo no local / retirada no balcão
  DELIVERY // pedido por telefone/WhatsApp lançado pelo atendente
}

enum OrigemContato {
  TELEFONE
  WHATSAPP
  PRESENCIAL
  SITE
}

enum TipoAtendimento {
  CONSUMO_LOCAL
  RETIRADA
  ENTREGA
}

enum StatusPedido {
  PENDENTE // chegou online, aguardando aceite
  RECEBIDO // aceito pelo estabelecimento
  EM_PREPARO
  PRONTO // pronto para retirada / aguardando motoboy
  SAIU_PARA_ENTREGA
  CONCLUIDO
  CANCELADO
  RECUSADO
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  VOUCHER
  OUTRO
}

enum StatusPagamento {
  PENDENTE // ex.: pagar na entrega
  CONFIRMADO
  ESTORNADO
}

enum StatusTurno {
  ABERTO
  FECHADO
}

enum TipoConferencia {
  CEGA // operador informa valores sem ver o esperado
  DETALHADA // operador vê o esperado durante a conferência
}

enum TipoMovimentacaoCaixa {
  VENDA // recebimento de pagamento de pedido
  ESTORNO_VENDA // devolução de pagamento
  SUPRIMENTO // reforço de troco
  SANGRIA // retirada
  DESPESA // pagamento de despesa com dinheiro do caixa
}

enum TipoProduto {
  VENDA // aparece no cardápio
  INSUMO // matéria-prima / embalagem, não vendável
}

enum UnidadeMedida {
  UN
  KG
  G
  L
  ML
  CX
}

enum TipoMovimentacaoEstoque {
  ENTRADA // compra / recebimento
  SAIDA_VENDA // baixa automática por pedido
  ESTORNO_VENDA // devolução por cancelamento
  AJUSTE // inventário (pode ser + ou -)
  PERDA // quebra, vencimento, desperdício
}

enum MomentoBaixaEstoque {
  ACEITE // ao aceitar/lançar o pedido
  CONCLUSAO // ao concluir o pedido (padrão)
}

enum TipoZonaEntrega {
  BAIRRO
  RAIO_KM
}

// -----------------------------------------------------------------------------
// LOJA (tenant) e configurações
// -----------------------------------------------------------------------------

model Loja {
  id                  String              @id @default(uuid()) @db.Uuid
  nome                String
  slug                String              @unique // usado na URL pública: apfood.app/{slug}
  cnpj                String?
  telefone            String?
  whatsapp            String?
  logoUrl             String?             @map("logo_url")
  corPrimaria         String?             @map("cor_primaria")
  // Endereço e geolocalização (base do cálculo de taxa por raio)
  logradouro          String?
  numero              String?
  bairro              String?
  cidade              String?
  uf                  String?             @db.Char(2)
  cep                 String?
  latitude            Decimal?            @db.Decimal(10, 7)
  longitude           Decimal?            @db.Decimal(10, 7)
  // Operação
  abertaParaPedidos   Boolean             @default(false) @map("aberta_para_pedidos")
  horarios            Json?               // [{ diaSemana: 0-6, abre: "18:00", fecha: "23:30" }]
  pedidoMinimoCentavos Int                @default(0) @map("pedido_minimo_centavos")
  tempoPreparoMin     Int                 @default(30) @map("tempo_preparo_min")
  aceiteAutomatico    Boolean             @default(false) @map("aceite_automatico")
  momentoBaixaEstoque MomentoBaixaEstoque @default(CONCLUSAO) @map("momento_baixa_estoque")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  usuarios               Usuario[]
  dispositivos           Dispositivo[]
  turnos                 TurnoCaixa[]
  movimentacoesCaixa     MovimentacaoCaixa[]
  categorias             Categoria[]
  produtos               Produto[]
  gruposAdicionais       GrupoAdicional[]
  clientes               Cliente[]
  zonasEntrega           ZonaEntrega[]
  entregadores           Entregador[]
  pedidos                Pedido[]
  movimentacoesEstoque   MovimentacaoEstoque[]
  categoriasDespesa      CategoriaDespesa[]
  despesas               Despesa[]
  sequencias             SequenciaPedido[]
  logs                   LogAuditoria[]

  @@map("lojas")
}

/// Contador atômico para numerar pedidos por loja e por dia (#001, #002...).
/// O número é atribuído pelo SERVIDOR; pedidos criados offline recebem um
/// código local provisório até sincronizar.
model SequenciaPedido {
  lojaId     String   @map("loja_id") @db.Uuid
  data       DateTime @db.Date
  ultimo     Int      @default(0)

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@id([lojaId, data])
  @@map("sequencias_pedido")
}

// -----------------------------------------------------------------------------
// USUÁRIOS, DISPOSITIVOS E AUDITORIA
// -----------------------------------------------------------------------------

model Usuario {
  id          String       @id @default(uuid()) @db.Uuid
  lojaId      String       @map("loja_id") @db.Uuid
  nome        String
  login       String
  email       String?
  senhaHash   String       @map("senha_hash") // argon2id
  pinHash     String?      @map("pin_hash") // PIN curto para troca rápida no PDV
  papel       PapelUsuario @default(OPERADOR)
  ativo       Boolean      @default(true)
  ultimoLogin DateTime?    @map("ultimo_login")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  loja                Loja                  @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  turnos              TurnoCaixa[]          @relation("TurnoOperador")
  turnosFechados      TurnoCaixa[]          @relation("TurnoFechadoPor")
  movimentacoesCaixa  MovimentacaoCaixa[]
  pedidosLancados     Pedido[]              @relation("PedidoAtendente")
  historicoStatus     HistoricoStatusPedido[]
  pagamentosRecebidos Pagamento[]
  movimentacoesEstoque MovimentacaoEstoque[]
  despesas            Despesa[]
  logs                LogAuditoria[]

  @@unique([lojaId, login])
  @@index([lojaId, updatedAt])
  @@map("usuarios")
}

/// Terminal/PC onde o app desktop está instalado. Permite rastrear a origem
/// de cada registro sincronizado e o último cursor de sync.
model Dispositivo {
  id             String    @id @default(uuid()) @db.Uuid
  lojaId         String    @map("loja_id") @db.Uuid
  nome           String // "Caixa 1", "Cozinha"
  tokenHash      String    @map("token_hash")
  ultimoSyncEm   DateTime? @map("ultimo_sync_em")
  versaoApp      String?   @map("versao_app")
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  loja    Loja         @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  turnos  TurnoCaixa[]
  pedidos Pedido[]

  @@map("dispositivos")
}

model LogAuditoria {
  id         String   @id @default(uuid()) @db.Uuid
  lojaId     String   @map("loja_id") @db.Uuid
  usuarioId  String?  @map("usuario_id") @db.Uuid
  acao       String // "PEDIDO_CANCELADO", "CAIXA_REABERTO", "PRECO_ALTERADO"...
  entidade   String
  entidadeId String?  @map("entidade_id")
  dados      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  loja    Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([lojaId, createdAt])
  @@index([entidade, entidadeId])
  @@map("logs_auditoria")
}

// -----------------------------------------------------------------------------
// CAIXA: TURNOS, MOVIMENTAÇÕES E CONFERÊNCIA
// -----------------------------------------------------------------------------

/// Um turno por operador. Regra (garantida na API + índice parcial na migration):
/// no máximo 1 turno ABERTO por usuário.
model TurnoCaixa {
  id                    String          @id @default(uuid()) @db.Uuid
  lojaId                String          @map("loja_id") @db.Uuid
  usuarioId             String          @map("usuario_id") @db.Uuid
  dispositivoId         String?         @map("dispositivo_id") @db.Uuid
  status                StatusTurno     @default(ABERTO)
  valorAberturaCentavos Int             @map("valor_abertura_centavos") // fundo de troco
  abertoEm              DateTime        @default(now()) @map("aberto_em")
  // Fechamento
  fechadoEm             DateTime?       @map("fechado_em")
  fechadoPorId          String?         @map("fechado_por_id") @db.Uuid
  tipoConferencia       TipoConferencia? @map("tipo_conferencia")
  totalEsperadoCentavos Int?            @map("total_esperado_centavos")
  totalInformadoCentavos Int?           @map("total_informado_centavos")
  diferencaCentavos     Int?            @map("diferenca_centavos") // >0 sobra, <0 quebra
  observacaoFechamento  String?         @map("observacao_fechamento")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  loja          Loja                @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  usuario       Usuario             @relation("TurnoOperador", fields: [usuarioId], references: [id])
  fechadoPor    Usuario?            @relation("TurnoFechadoPor", fields: [fechadoPorId], references: [id])
  dispositivo   Dispositivo?        @relation(fields: [dispositivoId], references: [id], onDelete: SetNull)
  movimentacoes MovimentacaoCaixa[]
  conferencias  ConferenciaCaixa[]
  pedidos       Pedido[]
  pagamentos    Pagamento[]
  despesas      Despesa[]

  @@index([lojaId, usuarioId, status])
  @@index([lojaId, abertoEm])
  @@map("turnos_caixa")
}

/// Livro-razão do turno. Valor sempre POSITIVO; o sinal vem do tipo
/// (VENDA/SUPRIMENTO = entrada; SANGRIA/DESPESA/ESTORNO_VENDA = saída).
model MovimentacaoCaixa {
  id             String                @id @default(uuid()) @db.Uuid
  lojaId         String                @map("loja_id") @db.Uuid
  turnoId        String                @map("turno_id") @db.Uuid
  usuarioId      String                @map("usuario_id") @db.Uuid
  tipo           TipoMovimentacaoCaixa
  formaPagamento FormaPagamento        @default(DINHEIRO) @map("forma_pagamento")
  valorCentavos  Int                   @map("valor_centavos")
  motivo         String?
  pagamentoId    String?               @unique @map("pagamento_id") @db.Uuid
  despesaId      String?               @unique @map("despesa_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  loja      Loja       @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  turno     TurnoCaixa @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  usuario   Usuario    @relation(fields: [usuarioId], references: [id])
  pagamento Pagamento? @relation(fields: [pagamentoId], references: [id], onDelete: SetNull)
  despesa   Despesa?   @relation(fields: [despesaId], references: [id], onDelete: SetNull)

  @@index([turnoId, tipo])
  @@index([lojaId, createdAt])
  @@map("movimentacoes_caixa")
}

/// Uma linha por forma de pagamento no fechamento: esperado x informado.
model ConferenciaCaixa {
  id                     String         @id @default(uuid()) @db.Uuid
  turnoId                String         @map("turno_id") @db.Uuid
  formaPagamento         FormaPagamento @map("forma_pagamento")
  valorEsperadoCentavos  Int            @map("valor_esperado_centavos")
  valorInformadoCentavos Int            @map("valor_informado_centavos")
  diferencaCentavos      Int            @map("diferenca_centavos")

  turno TurnoCaixa @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  @@unique([turnoId, formaPagamento])
  @@map("conferencias_caixa")
}

// -----------------------------------------------------------------------------
// CARDÁPIO: CATEGORIAS, PRODUTOS, ADICIONAIS E FICHA TÉCNICA
// -----------------------------------------------------------------------------

model Categoria {
  id        String    @id @default(uuid()) @db.Uuid
  lojaId    String    @map("loja_id") @db.Uuid
  nome      String
  descricao String?
  ordem     Int       @default(0)
  ativa     Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  loja     Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  produtos Produto[]

  @@index([lojaId, updatedAt])
  @@map("categorias")
}

/// Produtos vendáveis E insumos ficam na mesma tabela (diferenciados por
/// `tipo`), o que simplifica estoque e ficha técnica.
///
/// Regras de estoque:
///   • controlaEstoque = true  → o próprio produto tem saldo e é baixado na venda
///     (ex.: lata de refrigerante, embalagem).
///   • baixarInsumos  = true  → na venda, baixa os insumos da ficha técnica
///     (ex.: X-Burguer baixa pão, carne, queijo).
///   • Ambos false             → não mexe em estoque (lanche artesanal simples).
model Produto {
  id                String        @id @default(uuid()) @db.Uuid
  lojaId            String        @map("loja_id") @db.Uuid
  categoriaId       String?       @map("categoria_id") @db.Uuid
  tipo              TipoProduto   @default(VENDA)
  nome              String
  descricao         String?
  imagemUrl         String?       @map("imagem_url")
  codigo            String? // SKU / código interno / código de barras
  precoCentavos     Int           @default(0) @map("preco_centavos")
  custoCentavos     Int?          @map("custo_centavos")
  ativo             Boolean       @default(true)
  disponivelOnline  Boolean       @default(true) @map("disponivel_online")
  ordem             Int           @default(0)
  // Estoque
  controlaEstoque   Boolean       @default(false) @map("controla_estoque")
  baixarInsumos     Boolean       @default(false) @map("baixar_insumos")
  unidade           UnidadeMedida @default(UN)
  estoqueAtual      Decimal       @default(0) @map("estoque_atual") @db.Decimal(12, 3)
  estoqueMinimo     Decimal?      @map("estoque_minimo") @db.Decimal(12, 3)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")

  loja                 Loja                    @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  categoria            Categoria?              @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  gruposAdicionais     ProdutoGrupoAdicional[]
  fichaTecnica         FichaTecnicaItem[]      @relation("FichaDoProduto")
  usadoEmFichas        FichaTecnicaItem[]      @relation("InsumoDaFicha")
  adicionaisQueConsomem Adicional[]            @relation("InsumoDoAdicional")
  itensPedido          ItemPedido[]
  movimentacoesEstoque MovimentacaoEstoque[]

  @@unique([lojaId, codigo])
  @@index([lojaId, tipo, ativo])
  @@index([lojaId, updatedAt])
  @@map("produtos")
}

/// Composição de um produto: quanto de cada insumo é consumido por unidade.
model FichaTecnicaItem {
  id         String  @id @default(uuid()) @db.Uuid
  produtoId  String  @map("produto_id") @db.Uuid
  insumoId   String  @map("insumo_id") @db.Uuid
  quantidade Decimal @db.Decimal(12, 3) // na unidade do insumo

  produto Produto @relation("FichaDoProduto", fields: [produtoId], references: [id], onDelete: Cascade)
  insumo  Produto @relation("InsumoDaFicha", fields: [insumoId], references: [id], onDelete: Restrict)

  @@unique([produtoId, insumoId])
  @@map("fichas_tecnicas")
}

/// Ex.: "Escolha o ponto da carne" (min 1, max 1), "Adicionais" (min 0, max 10).
model GrupoAdicional {
  id         String    @id @default(uuid()) @db.Uuid
  lojaId     String    @map("loja_id") @db.Uuid
  nome       String
  minSelecao Int       @default(0) @map("min_selecao")
  maxSelecao Int       @default(1) @map("max_selecao")
  ordem      Int       @default(0)
  ativo      Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  loja       Loja                    @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  adicionais Adicional[]
  produtos   ProdutoGrupoAdicional[]

  @@index([lojaId, updatedAt])
  @@map("grupos_adicionais")
}

model ProdutoGrupoAdicional {
  produtoId String @map("produto_id") @db.Uuid
  grupoId   String @map("grupo_id") @db.Uuid
  ordem     Int    @default(0)

  produto Produto        @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  grupo   GrupoAdicional @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@id([produtoId, grupoId])
  @@map("produtos_grupos_adicionais")
}

model Adicional {
  id               String    @id @default(uuid()) @db.Uuid
  grupoId          String    @map("grupo_id") @db.Uuid
  nome             String
  precoCentavos    Int       @default(0) @map("preco_centavos")
  maxPorItem       Int       @default(1) @map("max_por_item") // ex.: bacon extra até 3x
  ativo            Boolean   @default(true)
  ordem            Int       @default(0)
  // Opcional: adicional que consome insumo (ex.: "Bacon extra" baixa 30 g de bacon)
  insumoId         String?   @map("insumo_id") @db.Uuid
  quantidadeInsumo Decimal?  @map("quantidade_insumo") @db.Decimal(12, 3)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  grupo       GrupoAdicional        @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  insumo      Produto?              @relation("InsumoDoAdicional", fields: [insumoId], references: [id], onDelete: SetNull)
  itensPedido ItemPedidoAdicional[]

  @@index([grupoId])
  @@map("adicionais")
}

// -----------------------------------------------------------------------------
// CLIENTES, ENTREGA E ENTREGADORES
// -----------------------------------------------------------------------------

model Cliente {
  id          String    @id @default(uuid()) @db.Uuid
  lojaId      String    @map("loja_id") @db.Uuid
  nome        String
  telefone    String // somente dígitos, com DDD: 11987654321
  email       String?
  observacoes String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  loja      Loja              @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  enderecos EnderecoCliente[]
  pedidos   Pedido[]

  @@unique([lojaId, telefone]) // busca por telefone no delivery
  @@index([lojaId, updatedAt])
  @@map("clientes")
}

model EnderecoCliente {
  id          String    @id @default(uuid()) @db.Uuid
  clienteId   String    @map("cliente_id") @db.Uuid
  apelido     String? // "Casa", "Trabalho"
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  uf          String?   @db.Char(2)
  cep         String?
  referencia  String?
  latitude    Decimal?  @db.Decimal(10, 7)
  longitude   Decimal?  @db.Decimal(10, 7)
  principal   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@map("enderecos_cliente")
}

/// Taxa por bairro (match pelo nome normalizado) ou por faixa de raio em km
/// a partir das coordenadas da loja.
model ZonaEntrega {
  id               String          @id @default(uuid()) @db.Uuid
  lojaId           String          @map("loja_id") @db.Uuid
  tipo             TipoZonaEntrega
  nome             String // nome do bairro ou rótulo da faixa
  raioMaxKm        Decimal?        @map("raio_max_km") @db.Decimal(6, 2)
  taxaCentavos     Int             @map("taxa_centavos")
  tempoEstimadoMin Int?            @map("tempo_estimado_min")
  ativa            Boolean         @default(true)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")

  loja    Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  pedidos Pedido[]

  @@index([lojaId, tipo, ativa])
  @@map("zonas_entrega")
}

model Entregador {
  id        String    @id @default(uuid()) @db.Uuid
  lojaId    String    @map("loja_id") @db.Uuid
  nome      String
  telefone  String?
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  loja    Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  pedidos Pedido[]

  @@index([lojaId, updatedAt])
  @@map("entregadores")
}

// -----------------------------------------------------------------------------
// PEDIDOS
// -----------------------------------------------------------------------------

model Pedido {
  id               String          @id @default(uuid()) @db.Uuid
  lojaId           String          @map("loja_id") @db.Uuid
  numero           Int? // atribuído pelo servidor (sequência diária)
  dataReferencia   DateTime        @default(now()) @map("data_referencia") @db.Date
  codigoLocal      String?         @map("codigo_local") // provisório quando criado offline
  canal            CanalVenda
  origemContato    OrigemContato?  @map("origem_contato")
  tipoAtendimento  TipoAtendimento @map("tipo_atendimento")
  status           StatusPedido    @default(PENDENTE)
  tokenRastreio    String          @unique @map("token_rastreio") // link público do cliente

  // Identificação (balcão: nome/senha/mesa)
  clienteId        String?         @map("cliente_id") @db.Uuid
  nomeCliente      String?         @map("nome_cliente")
  telefoneCliente  String?         @map("telefone_cliente")
  mesa             String?
  senha            String?

  // Endereço de entrega (snapshot — não muda se o cadastro do cliente mudar)
  entregaLogradouro  String?  @map("entrega_logradouro")
  entregaNumero      String?  @map("entrega_numero")
  entregaComplemento String?  @map("entrega_complemento")
  entregaBairro      String?  @map("entrega_bairro")
  entregaCidade      String?  @map("entrega_cidade")
  entregaCep         String?  @map("entrega_cep")
  entregaReferencia  String?  @map("entrega_referencia")
  entregaLatitude    Decimal? @map("entrega_latitude") @db.Decimal(10, 7)
  entregaLongitude   Decimal? @map("entrega_longitude") @db.Decimal(10, 7)
  zonaEntregaId      String?  @map("zona_entrega_id") @db.Uuid
  entregadorId       String?  @map("entregador_id") @db.Uuid

  // Valores (centavos)
  subtotalCentavos     Int  @default(0) @map("subtotal_centavos")
  taxaEntregaCentavos  Int  @default(0) @map("taxa_entrega_centavos")
  descontoCentavos     Int  @default(0) @map("desconto_centavos")
  acrescimoCentavos    Int  @default(0) @map("acrescimo_centavos")
  totalCentavos        Int  @default(0) @map("total_centavos")
  trocoParaCentavos    Int? @map("troco_para_centavos")

  observacao           String?
  motivoCancelamento   String?  @map("motivo_cancelamento")
  estoqueBaixado       Boolean  @default(false) @map("estoque_baixado") // idempotência da baixa

  // Vínculos operacionais
  turnoId              String?  @map("turno_id") @db.Uuid
  atendenteId          String?  @map("atendente_id") @db.Uuid
  dispositivoId        String?  @map("dispositivo_id") @db.Uuid

  // Linha do tempo
  aceitoEm             DateTime? @map("aceito_em")
  emPreparoEm          DateTime? @map("em_preparo_em")
  prontoEm             DateTime? @map("pronto_em")
  saiuEntregaEm        DateTime? @map("saiu_entrega_em")
  concluidoEm          DateTime? @map("concluido_em")
  canceladoEm          DateTime? @map("cancelado_em")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  loja        Loja                    @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  cliente     Cliente?                @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  zonaEntrega ZonaEntrega?            @relation(fields: [zonaEntregaId], references: [id], onDelete: SetNull)
  entregador  Entregador?             @relation(fields: [entregadorId], references: [id], onDelete: SetNull)
  turno       TurnoCaixa?             @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  atendente   Usuario?                @relation("PedidoAtendente", fields: [atendenteId], references: [id], onDelete: SetNull)
  dispositivo Dispositivo?            @relation(fields: [dispositivoId], references: [id], onDelete: SetNull)
  itens       ItemPedido[]
  pagamentos  Pagamento[]
  historico   HistoricoStatusPedido[]
  movimentacoesEstoque MovimentacaoEstoque[]

  @@unique([lojaId, dataReferencia, numero])
  @@index([lojaId, status])
  @@index([lojaId, createdAt])
  @@index([lojaId, canal, createdAt])
  @@index([lojaId, updatedAt])
  @@index([turnoId])
  @@map("pedidos")
}

model ItemPedido {
  id                       String  @id @default(uuid()) @db.Uuid
  pedidoId                 String  @map("pedido_id") @db.Uuid
  produtoId                String? @map("produto_id") @db.Uuid
  nomeProduto              String  @map("nome_produto") // snapshot
  quantidade               Int
  precoUnitarioCentavos    Int     @map("preco_unitario_centavos") // snapshot
  totalAdicionaisCentavos  Int     @default(0) @map("total_adicionais_centavos") // por unidade
  totalCentavos            Int     @map("total_centavos") // (unit + adicionais) * qtd
  observacao               String?

  pedido     Pedido                @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto    Produto?              @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  adicionais ItemPedidoAdicional[]

  @@index([pedidoId])
  @@index([produtoId])
  @@map("itens_pedido")
}

model ItemPedidoAdicional {
  id                    String  @id @default(uuid()) @db.Uuid
  itemPedidoId          String  @map("item_pedido_id") @db.Uuid
  adicionalId           String? @map("adicional_id") @db.Uuid
  nome                  String // snapshot
  quantidade            Int     @default(1)
  precoUnitarioCentavos Int     @map("preco_unitario_centavos") // snapshot

  itemPedido ItemPedido @relation(fields: [itemPedidoId], references: [id], onDelete: Cascade)
  adicional  Adicional? @relation(fields: [adicionalId], references: [id], onDelete: SetNull)

  @@index([itemPedidoId])
  @@map("itens_pedido_adicionais")
}

/// Um pedido pode ter vários pagamentos (ex.: parte Pix, parte dinheiro).
model Pagamento {
  id                    String          @id @default(uuid()) @db.Uuid
  pedidoId              String          @map("pedido_id") @db.Uuid
  forma                 FormaPagamento
  status                StatusPagamento @default(PENDENTE)
  valorCentavos         Int             @map("valor_centavos") // valor abatido do pedido
  valorRecebidoCentavos Int?            @map("valor_recebido_centavos") // dinheiro entregue pelo cliente
  trocoCentavos         Int             @default(0) @map("troco_centavos")
  pagoOnline            Boolean         @default(false) @map("pago_online")
  referenciaExterna     String?         @map("referencia_externa") // txid Pix, NSU cartão
  // Turno em que o dinheiro efetivamente entrou (definido ao CONFIRMAR)
  turnoId               String?         @map("turno_id") @db.Uuid
  recebidoPorId         String?         @map("recebido_por_id") @db.Uuid
  confirmadoEm          DateTime?       @map("confirmado_em")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  pedido       Pedido             @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  turno        TurnoCaixa?        @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  recebidoPor  Usuario?           @relation(fields: [recebidoPorId], references: [id], onDelete: SetNull)
  movimentacao MovimentacaoCaixa?

  @@index([pedidoId])
  @@index([turnoId, forma])
  @@map("pagamentos")
}

model HistoricoStatusPedido {
  id           String        @id @default(uuid()) @db.Uuid
  pedidoId     String        @map("pedido_id") @db.Uuid
  statusDe     StatusPedido? @map("status_de")
  statusPara   StatusPedido  @map("status_para")
  usuarioId    String?       @map("usuario_id") @db.Uuid
  observacao   String?
  createdAt    DateTime      @default(now()) @map("created_at")

  pedido  Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([pedidoId, createdAt])
  @@map("historico_status_pedido")
}

// -----------------------------------------------------------------------------
// ESTOQUE
// -----------------------------------------------------------------------------

/// Toda alteração de saldo gera uma linha aqui (kardex). `quantidade` é
/// assinada: positiva = entrada, negativa = saída.
model MovimentacaoEstoque {
  id                   String                  @id @default(uuid()) @db.Uuid
  lojaId               String                  @map("loja_id") @db.Uuid
  produtoId            String                  @map("produto_id") @db.Uuid
  tipo                 TipoMovimentacaoEstoque
  quantidade           Decimal                 @db.Decimal(12, 3)
  saldoAnterior        Decimal                 @map("saldo_anterior") @db.Decimal(12, 3)
  saldoPosterior       Decimal                 @map("saldo_posterior") @db.Decimal(12, 3)
  custoUnitarioCentavos Int?                   @map("custo_unitario_centavos")
  motivo               String?
  pedidoId             String?                 @map("pedido_id") @db.Uuid
  usuarioId            String?                 @map("usuario_id") @db.Uuid
  createdAt            DateTime                @default(now()) @map("created_at")

  loja    Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  produto Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  pedido  Pedido?  @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([produtoId, createdAt])
  @@index([lojaId, createdAt])
  @@index([pedidoId])
  @@map("movimentacoes_estoque")
}

// -----------------------------------------------------------------------------
// FINANCEIRO: DESPESAS (saídas para o fluxo de caixa)
// -----------------------------------------------------------------------------

model CategoriaDespesa {
  id        String    @id @default(uuid()) @db.Uuid
  lojaId    String    @map("loja_id") @db.Uuid
  nome      String // "Fornecedores", "Aluguel", "Motoboys", "Energia"...
  ativa     Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  loja     Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  despesas Despesa[]

  @@unique([lojaId, nome])
  @@map("categorias_despesa")
}

model Despesa {
  id              String          @id @default(uuid()) @db.Uuid
  lojaId          String          @map("loja_id") @db.Uuid
  categoriaId     String?         @map("categoria_id") @db.Uuid
  descricao       String
  valorCentavos   Int             @map("valor_centavos")
  dataCompetencia DateTime        @map("data_competencia") @db.Date
  dataPagamento   DateTime?       @map("data_pagamento") @db.Date
  formaPagamento  FormaPagamento? @map("forma_pagamento")
  // Se paga com dinheiro do caixa, vincula ao turno (gera MovimentacaoCaixa DESPESA)
  turnoId         String?         @map("turno_id") @db.Uuid
  usuarioId       String?         @map("usuario_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  loja         Loja              @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  categoria    CategoriaDespesa? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  turno        TurnoCaixa?       @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  usuario      Usuario?          @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  movimentacao MovimentacaoCaixa?

  @@index([lojaId, dataCompetencia])
  @@map("despesas")
}
