{
  "name": "apfood",
  "version": "0.1.0",
  "private": true,
  "description": "ApFood — PDV, gestão e cardápio digital para restaurantes e hamburguerias",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@apfood/api",
    "dev:web": "turbo run dev --filter=@apfood/web",
    "dev:desktop": "turbo run dev --filter=@apfood/desktop",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "db:up": "docker compose up -d postgres",
    "db:generate": "pnpm --filter @apfood/database db:generate",
    "db:migrate": "pnpm --filter @apfood/database db:migrate",
    "db:extras": "pnpm --filter @apfood/database db:extras",
    "db:seed": "pnpm --filter @apfood/database db:seed",
    "db:studio": "pnpm --filter @apfood/database db:studio"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
