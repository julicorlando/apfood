{
  "name": "@apfood/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsup src/server.ts --format esm --target node22 --out-dir dist",
    "start": "node --env-file=../../.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apfood/database": "workspace:*",
    "@apfood/shared": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "argon2": "^0.43.0",
    "fastify": "^5.4.0",
    "socket.io": "^4.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
